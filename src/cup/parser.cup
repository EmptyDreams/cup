
/*================================================================*/
/*
  JavaCup Specification for the JavaCup Specification Language
  by Scott Hudson, GVU Center, Georgia Tech, August 1995
  and Frank Flannery, Department of Computer Science, Princeton Univ,
  July 1996.
  Bug Fixes: C. Scott Ananian, Dept of Electrical Engineering, Princeton
  University, October 1996. [later Massachusetts Institute of Technology]


  This JavaCup specification is used to implement JavaCup itself.
  It specifies the parser for the JavaCup specification language.
  (It also serves as a reasonable example of what a typical JavaCup
  spec looks like).

  The specification has the following parts:

    Package and import declarations
      These serve the same purpose as in a normal Java source file
      (and will appear in the generated code for the parser).  In this
      case we are part of the java_cup package and we import the
      java_cup runtime system.

    Action code
      This section provides code that is included with the class encapsulating
      the various pieces of user code embedded in the grammar (i.e., the
      semantic actions).  This provides a series of helper routines and
      data structures that the semantic actions use.

    Parser code
      This section provides code included in the parser class itself.  In this
      case we override the default error reporting routines.

    Init with and scan with
      These sections provide small bits of code that initialize, then
      indicate how to invoke the scanner.

    Symbols and grammar
      These sections declare all of the terminal and non terminal symbols
      and the types of objects that they will be represented by at runtime,
      then indicate the start symbol of the grammar (), and finally provide
      the grammar itself (with embedded actions).

    Operation of the parser
      This grammar is generated in -ast mode (see the generateCupParser
      task): the spec tree consists of the generated Node* classes, one
      field per label, built by the auto actions baked into the generated
      parser.  Every list and option uses the fork's own quantifier sugar
      (X*, X?, X+, [SEP !]+), and labels that appear in only some
      alternatives of a non-terminal (st, tkw/ntkw, a/p/i/sc, l/r/n, s,
      q, ...) are deliberate discriminators -- alternative identity is
      recoverable from which getters are non-null.  The few remaining
      actions either compute plain string values (multipart_id and
      friends, written against the always-declared <name>Sym locals so
      they survive -ast's suppression of plain label-value locals) or
      produce sentinel nodes on the error-recovery alternatives.  After
      the parse, Main hands the tree to java_cup.Lowering, which replays
      the historical graph construction (symbol tables, desugaring,
      Production numbering) in exactly the old order.

  Author(s)
    Scott Hudson, GVU Center, Georgia Tech.
    Frank Flannery, Department of Computer Science, Princeton Univ.
    C. Scott Ananian, Dept of Electrical Engineering, Princeton Univ.

  Revisions
    v0.9a   First released version                     [SEH] 8/29/95
    v0.9b   Updated for beta language (throws clauses) [SEH] 11/25/95
    v0.10a   Made many improvements/changes. now offers:
              return value
              left/right positions and propagations
              cleaner label references
              precedence and associativity for terminals
              contextual precedence for productions
              [FF] 7/3/96
    v0.10b   Fixed %prec directive so it works like it's supposed to.
              [CSA] 10/10/96
    v0.10g   Added support for array types on symbols.
              [CSA] 03/23/98
    v0.10i   Broaden set of IDs allowed in multipart_id and label_id so
            that only java reserved words (and not CUP reserved words like
            'parser' and 'start') are prohibited.  Allow reordering of
	    action code, parser code, init code, and scan with sections,
            and made closing semicolon optional for these sections.
	    Added 'nonterminal' as a terminal symbol, finally fixing a
	    spelling mistake that's been around since the beginning.
	    For backwards compatibility, you can still misspell the
	    word if you like.
*/
/*================================================================*/

package java_cup;
import java_cup.runtime.*;
import java_cup.runtime.symbol.complex.*;

/*----------------------------------------------------------------*/

action code {:
  /* The former helper routines and accumulators (add_lab, add_rhs_part,
     handle_rhs_expr, the symbol tables, ...) now live in java_cup.Lowering.
     The actions in this grammar only compute string values and produce
     sentinel nodes for error recovery; the spec tree itself is built by
     the -ast auto actions. */
:};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

parser code {:
 /* override error routines */
  protected Lexer lexer;
  public boolean debugSymbols;
  public void setDebugSymbols(boolean debugSymbols){
  	this.debugSymbols = debugSymbols;
  }
  public void report_fatal_error(
    String   message,
    Object   info)
    {
      done_parsing();
      if (info instanceof Symbol) ErrorManager.getManager().emit_fatal(message+ "\nCan't recover from previous error(s), giving up.",(Symbol)info);
      else ErrorManager.getManager().emit_fatal(message + "\nCan't recover from previous error(s), giving up.",cur_token);
      System.exit(1);
    }

    public void report_error(String message, Object info)
    {
      if (info instanceof Symbol)
         ErrorManager.getManager().emit_error(message,(Symbol)info);
      else
         ErrorManager.getManager().emit_error(message,cur_token);
    }
:};

/*---------------------------------------------------------------- */

init with {:
    ComplexSymbolFactory f = new ComplexSymbolFactory(
      GrammarSymConstants.TERMINAL_NAMES,
      GrammarSymConstants.NON_TERMINAL_NAMES
    );
    symbolFactory = f;
    lexer = new Lexer(f);
:}
/*lexer.init(); :};*/
scan with {:
    return lexer.next_token();
:};

/*----------------------------------------------------------------*/

terminal
  PACKAGE, IMPORT, STATIC ,CODE, ACTION, PARSER, TERMINAL, NON, INIT, SCAN, WITH,
  START, SEMI, COMMA, STAR, DOT, PLUS, COLON, COLON_COLON, COLON_COLON_EQUALS, BAR, PRECEDENCE,
  LEFT, RIGHT, NONASSOC, PERCENT_PREC, PERCENT_NAMER,
  LPAREN, RPAREN, LBRACK, RBRACK, NONTERMINAL, GT, LT, SPREAD,
  QUESTION, EXCLAMATION, SUPER, EXTENDS, CLASS;

terminal String  ID, CODE_STRING;

/* node non-terminals: -ast builds their Node* classes from the labels */
non terminal AstNode spec, import_spec, code_part, symbol, preced,
                    production, rhs, prod_part, quantifier,
                    symbol_id, anon_expr, id_ref;

/* value non-terminals: plain Java values computed by explicit actions
   (every production must carry one -- the auto action would otherwise
   emit garbage like `new String()` for them) */
non terminal String package_spec, class_name, start_spec;
non terminal String nt_id, label_id, opt_label, robust_id;
non terminal String multipart_id, import_id, type_id;
non terminal String typearglist, typearguement, wildcard;
non terminal String star_or_plus, question_or_exclamation, opt_return_type;
non terminal String non_terminal;
non terminal opt_semi;

/*----------------------------------------------------------------*/

start with spec;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

/* symbol+ / production+ (not *) keep the historical requirement of at
   least one symbol declaration and one production -- and their
   non-nullability is what keeps `error` out of the lookahead set of the
   leading epsilon reductions, so the error-recovery alternative below
   stays conflict-free */
spec ::=
	package_spec:pkg
	import_spec*:imports
	class_name:cls
	code_part*:codes
	symbol+:syms
	preced*:precs
	start_spec:start
	production+:prods
	|
	/* error recovery assuming something went wrong before symbols
	   and we have TERMINAL or NON TERMINAL to sync on.  if we get an
	   error after that, we recover inside the symbol or production
	   list boxes
	*/
	error
	symbol+:syms
	preced*:precs
	start_spec:start
	production+:prods
	{: RESULT = new NodeSpec(); :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

package_spec ::=
	PACKAGE
	multipart_id:name
	SEMI
	{: RESULT = nameSym.<String>value(); :}
	|
	{: RESULT = null; :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

import_spec ::=
	IMPORT
	import_id:target
	SEMI
	|
	IMPORT
	STATIC:st
	import_id:target
	SEMI
	;

class_name ::=
    {: RESULT = null; :}
    |
    CLASS ID:id SEMI
    {: RESULT = idSym.<String>value(); :}
    ;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

// any order of the four kinds; all optional. [CSA, 23-Jul-1999]
// (Lowering checks for a second part of any kind and warns)
code_part ::=
	ACTION:a CODE CODE_STRING:code opt_semi
	| PARSER:p CODE CODE_STRING:code opt_semi
	| INIT:i WITH CODE_STRING:code opt_semi
	| SCAN:sc WITH CODE_STRING:code opt_semi
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

symbol ::=
	TERMINAL:tkw
	type_id:ty
	id_ref[COMMA !]+:names
	SEMI
	|
	TERMINAL:tkw
	id_ref[COMMA !]+:names
	SEMI
	|
	non_terminal:ntkw
	type_id:ty
	id_ref[COMMA !]+:names
	SEMI
	|
	non_terminal:ntkw
	id_ref[COMMA !]+:names
	SEMI
	|
	/* error recovery productions -- sync on semicolon; the all-null
	   sentinel node lowers to nothing (the old grammar produced null
	   here and filtered it while building the list) */

	TERMINAL
	error
	SEMI
	{: RESULT = new NodeSymbol(); :}
	|
	non_terminal
	error
	SEMI
	{: RESULT = new NodeSymbol(); :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

preced ::=
	PRECEDENCE LEFT:l
	symbol_id[COMMA !]+:refs SEMI
	|
	PRECEDENCE RIGHT:r
	symbol_id[COMMA !]+:refs SEMI
	|
	PRECEDENCE NONASSOC:n
	symbol_id[COMMA !]+:refs SEMI
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

start_spec ::=
	START WITH nt_id:start_name
	SEMI
	{: RESULT = start_nameSym.<String>value(); :}
	|
	{: RESULT = null; :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

production ::=
	nt_id:lhs
	COLON_COLON_EQUALS
	rhs[BAR !]+:alts
	SEMI
	|
	error
	{: ErrorManager.getManager().emit_error("Syntax Error"); :}
	SEMI
	{: RESULT = new NodeProduction(); :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

rhs ::=
	prod_part*:parts PERCENT_PREC symbol_id:prec PERCENT_NAMER ID:namer
	|
	prod_part*:parts PERCENT_NAMER ID:namer
	|
	prod_part*:parts PERCENT_PREC symbol_id:prec
	|
	prod_part*:parts
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

prod_part ::=
	SPREAD:s symbol_id:symid quantifier?:quant opt_label:labid
	|
	symbol_id:symid quantifier?:quant opt_label:labid
	|
	CODE_STRING:code_str
	;

quantifier ::=
  QUESTION:q
  | star_or_plus:sp
  | LBRACK symbol_id+:seps question_or_exclamation:qe RBRACK star_or_plus:sp
  ;

star_or_plus ::=
  STAR {: RESULT = "*"; :}
  | PLUS {: RESULT = "+"; :};

question_or_exclamation ::=
  QUESTION {: RESULT = "?"; :}
  | EXCLAMATION {: RESULT = "!"; :};

opt_return_type ::=
    COLON_COLON ID:type {: RESULT = typeSym.<String>value(); :}
    | {: RESULT = null; :};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

opt_label ::=
	COLON label_id:labid
	{: RESULT = labidSym.<String>value(); :}
	|
	{: RESULT = null; :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

multipart_id ::=
	multipart_id:base DOT robust_id:another_id
	{: RESULT = baseSym.<String>value() + "." + another_idSym.<String>value(); :}
	|multipart_id:base
        LT typearglist:types GT
	 {: RESULT = baseSym.<String>value() + "<" + typesSym.<String>value() + ">"; :}
        |
	robust_id:an_id
	{: RESULT = an_idSym.<String>value(); :}
	;
/*. . . . . . . .TUM CHANGES. . . . . . . . . . . . . . . */


typearglist ::=
            typearguement:arg
            {: RESULT = argSym.<String>value(); :}
            | typearglist:list COMMA typearguement:arg
            {: RESULT = listSym.<String>value() + "," + argSym.<String>value(); :}
            ;

typearguement ::=
              type_id:t
              {: RESULT = tSym.<String>value(); :}
              | wildcard:w
              {: RESULT = wSym.<String>value(); :}
              ;

wildcard ::=
         QUESTION
         {: RESULT = " ? "; :}
         | QUESTION EXTENDS type_id:t
         {: RESULT = " ? extends " + tSym.<String>value(); :}
         | QUESTION SUPER type_id:t
         {: RESULT = " ? super " + tSym.<String>value(); :}
         ;

/*. . . . . . . .END TUM CHANGES. . . . . . . . . . . . . . . */


/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

import_id ::=
	multipart_id:name DOT STAR
	{: RESULT = nameSym.<String>value() + ".*"; :}
	|
	multipart_id:name
	{: RESULT = nameSym.<String>value(); :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

type_id ::= multipart_id:m {: RESULT = mSym.<String>value(); :}
	| type_id:t LBRACK RBRACK
	{: RESULT = tSym.<String>value() + "[]"; :}
       	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

/* a name inside a terminal / non terminal declaration list; the node
   wrapper keeps the list box element a node type */
id_ref ::=
	ID:the_id
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

nt_id ::=
	ID:the_id
	{: RESULT = the_idSym.<String>value(); :}
	| error
	{:
		ErrorManager.getManager().emit_error("Illegal use of reserved word");
		RESULT="ILLEGAL";
	:}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

symbol_id ::=
	ID:the_id
	| anon_expr:anon
	| error
	{:
		ErrorManager.getManager().emit_error("Illegal use of reserved word");
		RESULT = new NodeSymbolId();
	:}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

anon_expr ::=
	LPAREN:lp opt_return_type:type rhs[BAR !]+:branches RPAREN
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

label_id ::=
	robust_id:the_id
	{: RESULT = the_idSym.<String>value(); :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

robust_id ::= /* all ids that aren't reserved words in Java */
	ID:the_id	{: RESULT = the_idSym.<String>value(); :}
	/* package is reserved. */
	/* import is reserved. */
	| CODE		{: RESULT = "code"; :}
	| ACTION	{: RESULT = "action"; :}
	| PARSER	{: RESULT = "parser"; :}
	| TERMINAL	{: RESULT = "terminal"; :}
	| NON		{: RESULT = "non"; :}
	| NONTERMINAL   {: RESULT = "nonterminal"; :}
	| INIT		{: RESULT = "init"; :}
	| SCAN		{: RESULT = "scan"; :}
	| WITH		{: RESULT = "with"; :}
	| START		{: RESULT = "start"; :}
	| PRECEDENCE	{: RESULT = "precedence"; :}
	| LEFT		{: RESULT = "left"; :}
	| RIGHT		{: RESULT = "right"; :}
	| NONASSOC	{: RESULT = "nonassoc"; :}
	| error
	{:
		ErrorManager.getManager().emit_error("Illegal use of reserved word");
		RESULT="ILLEGAL";
	:}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

non_terminal ::= NON TERMINAL {: RESULT = "nonterminal"; :} | NONTERMINAL {: RESULT = "nonterminal"; :};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

opt_semi ::= /* nothing */
	{: RESULT = null; :}
	| SEMI {: RESULT = null; :};

/*----------------------------------------------------------------*/
