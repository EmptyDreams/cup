
/*================================================================*/
/*
  JavaCup Specification for the JavaCup Specification Language
  by Scott Hudson, GVU Center, Georgia Tech, August 1995
  and Frank Flannery, Department of Computer Science, Princeton Univ,
  July 1996.
  Bug Fixes: C. Scott Ananian, Dept of Electrical Engineering, Princeton
  University, October 1996. [later Massachusetts Institute of Technology]


  This JavaCup specification is used to implement JavaCup itself.
  It specifies the parser for the JavaCup specification language.
  (It also serves as a reasonable example of what a typical JavaCup
  spec looks like).

  The specification has the following parts:

    Package and import declarations
      These serve the same purpose as in a normal Java source file
      (and will appear in the generated code for the parser). In this
      case we are part of the java_cup package and we import both the
      java_cup runtime system and HashMap from the standard Java
      utilities package.

    Action code
      This section provides code that is included with the class encapsulating
      the various pieces of user code embedded in the grammar (i.e., the
      semantic actions).  This provides a series of helper routines and
      data structures that the semantic actions use.

    Parser code
      This section provides code included in the parser class itself.  In
      this case we override the default error reporting routines.

    Init with and scan with
      These sections provide small bits of code that initialize, then
      indicate how to invoke the scanner.

    Symbols and grammar
      These sections declare all of the terminal and non terminal symbols
      and the types of objects that they will be represented by at runtime,
      then indicate the start symbol of the grammar (), and finally provide
      the grammar itself (with embedded actions).

    Operation of the parser
      The parser acts by building an immutable, sugar-preserving tree of
      java_cup.spec nodes (SpecNode and friends).  Every semantic action
      below is pure construction: it reads the labeled RESULTs of its
      parts, builds a node, and returns it as its own RESULT.  No global
      state is touched during the parse.  After the parse, Main hands the
      tree to java_cup.Lowering, which replays the historical graph
      construction (symbol tables, desugaring, Production numbering) in
      exactly the old order.  Positions are taken from the labeled
      <name>Sym symbols, whose ComplexLocation spans come from the lexer.

      The grammar rules themselves are structurally frozen: mid-rule
      action blocks of the old builder version are kept as empty {: :}
      stubs so the epsilon productions -- and with them the LALR
      automaton -- stay identical, and the committed bootstrap jar
      (bin/java-cup-11.jar) can always regenerate this parser.

  Author(s)
    Scott Hudson, GVU Center, Georgia Tech.
    Frank Flannery, Department of Computer Science, Princeton Univ.
    C. Scott Ananian, Dept. of Electrical Engineering, Princeton Univ.

  Revisions
    v0.9a   First released version                     [SEH] 8/29/95
    v0.9b   Updated for beta language (throws clauses) [SEH] 11/25/95
    v0.10a   Made many improvements/changes. now offers:
              return value
              left/right positions and propagations
              cleaner label references
              precedence and associativity for terminals
              contextual precedence for productions
              [FF] 7/3/96
    v0.10b   Fixed %prec directive so it works like it's supposed to.
              [CSA] 10/10/96
    v0.10g   Added support for array types on symbols.
              [CSA] 03/23/98
    v0.10i   Broaden set of IDs allowed in multipart_id and label_id so
            that only java reserved words (and not CUP reserved words like
            'parser' and 'start') are prohibited.  Allow reordering of
	    action code, parser code, init code, and scan with sections,
	    and made closing semicolon optional for these sections.
	    Added 'nonterminal' as a terminal symbol, finally fixing a
	    spelling mistake that's been around since the beginning.
	    For backwards compatibility, you can still misspell the
	    word if you like.
*/
/*================================================================*/

package java_cup;
import java_cup.runtime.*;
import java_cup.runtime.symbol.complex.*;
import java_cup.spec.*;
import java.util.List;
import java.util.ArrayList;
import java.util.Map;
import java.util.HashMap;

/*----------------------------------------------------------------*/

action code {:
  /* The former helper routines and accumulators (add_lab, add_rhs_part,
     handle_rhs_expr, the symbol tables, ...) now live in java_cup.Lowering.
     The actions in this grammar only construct spec tree nodes. */
:};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

parser code {:
 /* override error routines */
  protected Lexer lexer;
  public boolean debugSymbols;
  public void setDebugSymbols(boolean debugSymbols){
  	this.debugSymbols = debugSymbols;
  }
  public void report_fatal_error(
    String   message,
    Object   info)
    {
      done_parsing();
      if (info instanceof Symbol) ErrorManager.getManager().emit_fatal(message+ "\nCan't recover from previous error(s), giving up.",(Symbol)info);
      else ErrorManager.getManager().emit_fatal(message + "\nCan't recover from previous error(s), giving up.",cur_token);
      System.exit(1);
    }

    public void report_error(String message, Object info)
    {
      if (info instanceof Symbol)
         ErrorManager.getManager().emit_error(message,(Symbol)info);
      else
         ErrorManager.getManager().emit_error(message,cur_token);
    }
:};

/*---------------------------------------------------------------- */

init with {:
    ComplexSymbolFactory f = new ComplexSymbolFactory(
      GrammarSymConstants.TERMINAL_NAMES,
      GrammarSymConstants.NON_TERMINAL_NAMES
    );
    symbolFactory = f;
    lexer = new Lexer(f);
:}
/*lexer.init(); :};*/
scan with {:
    return lexer.next_token();
:};

/*----------------------------------------------------------------*/

terminal
  PACKAGE, IMPORT, STATIC ,CODE, ACTION, PARSER, TERMINAL, NON, INIT, SCAN, WITH,
  START, SEMI, COMMA, STAR, DOT, PLUS, COLON, COLON_COLON, COLON_COLON_EQUALS, BAR, PRECEDENCE,
  LEFT, RIGHT, NONASSOC, PERCENT_PREC, PERCENT_NAMER,
  LPAREN, RPAREN, LBRACK, RBRACK, NONTERMINAL, GT, LT, SPREAD,
  QUESTION, EXCLAMATION, SUPER, EXTENDS, CLASS;

terminal String  ID, CODE_STRING;

/* purely structural symbols -- no RESULT value */
non terminal
  opt_semi, non_terminal, empty;

non terminal SpecNode spec;
non terminal String package_spec, class_name, start_spec;
non terminal String nt_id, label_id, opt_label, robust_id;
non terminal String multipart_id, import_id, type_id;
non terminal String typearglist, typearguement, wildcard;
non terminal String new_term_id, new_non_term_id;
non terminal String star_or_plus, question_or_exclamation, opt_return_type;
non terminal boolean opt_spread;
non terminal ImportNode import_spec;
non terminal CodePartNode code_part, action_code_part,
                        parser_code_part, init_code, scan_code;
non terminal SymbolDeclNode symbol;
non terminal List<ImportNode> import_list;
non terminal List<CodePartNode> code_parts;
non terminal List<SymbolDeclNode> symbol_list;
non terminal List<String> declares_term, declares_non_term,
                          term_name_list, non_term_name_list;
non terminal PrecedenceNode preced;
non terminal List<PrecedenceNode> precedence_list, precedence_l;
non terminal SymRef terminal_id, term_id, symbol_id;
non terminal List<SymRef> terminal_list, symbol_id_list;
non terminal QuantifierNode opt_quantifier;
non terminal List<ProductionNode> production_list;
non terminal ProductionNode production;
non terminal List<RhsNode> rhs_list;
non terminal RhsNode rhs;
non terminal List<PartNode> prod_part_list;
non terminal PartNode prod_part;

/*----------------------------------------------------------------*/

start with spec;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

spec ::=
	{:
          /* the old seeding of the "error" terminal and the "$START"
             non terminal is now the pre-pass of Lowering.run() */
	:}
	package_spec:pkg
	import_list:imports
	class_name:cls
	code_parts:codes
	symbol_list:syms
	precedence_list:precs
	start_spec:start
	production_list:prods
	{:
	  RESULT = new SpecNode(pkg, imports, cls, codes, syms, precs,
	                        start, prods, false);
	:}
	|
	/* error recovery assuming something went wrong before symbols
	   and we have TERMINAL or NON TERMINAL to sync on.  if we get an
	   error after that, we recover inside symbol_list or
	   production_list
	*/
	error
	symbol_list:syms
	precedence_list:precs
	start_spec:start
	production_list:prods
	{:
	  /* sections parsed before the error are lost from the tree (no
	     output is produced once a parse error is on record) */
	  RESULT = new SpecNode(null, new ArrayList<>(), null,
	                        new ArrayList<>(), syms, precs,
	                        start, prods, true);
	:}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

package_spec ::=
	PACKAGE
	multipart_id:name
	{: :}
	SEMI
	{: RESULT = name; :}
	|
	empty
	{: RESULT = null; :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

import_list ::=
	import_list:list
	import_spec:imp
	{:
	  if (list == null) list = new ArrayList<>();
	  list.add(imp);
	  RESULT = list;
	:}
	|
	empty
	{: RESULT = new ArrayList<>(); :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

import_spec ::=
	IMPORT
	import_id:target
	{: :}
	SEMI
	{: RESULT = new ImportNode(false, target); :}
	|
	IMPORT STATIC
	import_id:target
	{: :}
	SEMI
	{: RESULT = new ImportNode(true, target); :}
	;

class_name ::=
    empty
    {: RESULT = null; :}
    |
    CLASS ID:id SEMI
    {: RESULT = id; :}
    ;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

// allow any order; all parts are optional. [CSA, 23-Jul-1999]
// (Lowering checks for a second part of any kind and warns)
code_part ::=
	action_code_part:cp {: RESULT = cp; :}
	| parser_code_part:cp {: RESULT = cp; :}
	| init_code:cp {: RESULT = cp; :}
	| scan_code:cp {: RESULT = cp; :} ;
code_parts ::=
	{: RESULT = new ArrayList<>(); :}
	| code_parts:list code_part:cp
	  {:
	    if (list == null) list = new ArrayList<>();
	    list.add(cp);
	    RESULT = list;
	  :};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

action_code_part ::=
	ACTION CODE CODE_STRING:user_code opt_semi
	{:
	  RESULT = new CodePartNode(CodePartNode.Kind.ACTION, user_code,
	                            (ComplexLocation) user_codeSym.getLocation());
	:}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

parser_code_part ::=
	PARSER CODE CODE_STRING:user_code opt_semi
	{:
	  RESULT = new CodePartNode(CodePartNode.Kind.PARSER, user_code,
	                            (ComplexLocation) user_codeSym.getLocation());
	:}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

init_code ::=
	INIT WITH CODE_STRING:user_code opt_semi
	{:
	  RESULT = new CodePartNode(CodePartNode.Kind.INIT, user_code,
	                            (ComplexLocation) user_codeSym.getLocation());
	:}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

scan_code ::=
	SCAN WITH CODE_STRING:user_code opt_semi
	{:
	  RESULT = new CodePartNode(CodePartNode.Kind.SCAN, user_code,
	                            (ComplexLocation) user_codeSym.getLocation());
	:}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

symbol_list ::= symbol_list:list symbol:s
	{:
	  if (list == null) list = new ArrayList<>();
	  if (s != null) list.add(s);
	  RESULT = list;
	:}
	| symbol:s
	{:
	  var r = new ArrayList<SymbolDeclNode>();
	  if (s != null) r.add(s);
	  RESULT = r;
	:};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

symbol ::=
	TERMINAL
	type_id:type
	declares_term:names
	{: RESULT = new SymbolDeclNode(true, type, names); :}
	|
	TERMINAL
	declares_term:names
	{: RESULT = new SymbolDeclNode(true, null, names); :}
	|
	non_terminal
	type_id:type
	declares_non_term:names
	{: RESULT = new SymbolDeclNode(false, type, names); :}
	|
	non_terminal
	declares_non_term:names
	{: RESULT = new SymbolDeclNode(false, null, names); :}
	|
	/* error recovery productions -- sync on semicolon */

	TERMINAL
	error
	{: :}
	SEMI
	{: RESULT = null; :}
	|
	non_terminal
	error
	{: :}
	SEMI
	{: RESULT = null; :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

declares_term ::=
	term_name_list:names
	{: :}
	SEMI
	{: RESULT = names; :}
	;
/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

declares_non_term ::=
	non_term_name_list:names
	{: :}
	SEMI
	{: RESULT = names; :}
	;
/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

term_name_list ::= term_name_list:list COMMA new_term_id:name
	{:
	  if (list == null) list = new ArrayList<>();
	  list.add(name);
	  RESULT = list;
	:}
	| new_term_id:name
	{:
	  var r = new ArrayList<String>();
	  r.add(name);
	  RESULT = r;
	:};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

non_term_name_list ::=
	non_term_name_list:list
	COMMA
	new_non_term_id:name
	{:
	  if (list == null) list = new ArrayList<>();
	  list.add(name);
	  RESULT = list;
	:}
	|
	new_non_term_id:name
	{:
	  var r = new ArrayList<String>();
	  r.add(name);
	  RESULT = r;
	:}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/


precedence_list ::= precedence_l:l {: RESULT = l; :} | empty
	{: RESULT = new ArrayList<>(); :};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

precedence_l ::= precedence_l:list preced:p
	{:
	  if (list == null) list = new ArrayList<>();
	  list.add(p);
	  RESULT = list;
	:}
	| preced:p
	{:
	  var r = new ArrayList<PrecedenceNode>();
	  r.add(p);
	  RESULT = r;
	:};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

preced ::=
	PRECEDENCE LEFT
	{: :}
        terminal_list:refs SEMI
	{: RESULT = new PrecedenceNode(assoc.left, refs); :}
	|
	PRECEDENCE RIGHT
	{: :}
        terminal_list:refs SEMI
	{: RESULT = new PrecedenceNode(assoc.right, refs); :}
	|
	PRECEDENCE NONASSOC
	{: :}
        terminal_list:refs SEMI
	{: RESULT = new PrecedenceNode(assoc.nonassoc, refs); :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

terminal_list ::= terminal_list:list COMMA terminal_id:ref
	{:
	  if (list == null) list = new ArrayList<>();
	  list.add(ref);
	  RESULT = list;
	:}
	|
	terminal_id:ref
	{:
	  var r = new ArrayList<SymRef>();
	  r.add(ref);
	  RESULT = r;
	:}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

terminal_id ::= term_id:sym
	{: RESULT = sym; :};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

term_id ::= symbol_id:sym_id
        {: RESULT = sym_id; :};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

start_spec ::=
	START WITH nt_id:start_name
	{: :}
	SEMI
	{: RESULT = start_name; :}
	|
	empty
	{: RESULT = null; :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

production_list ::= production_list:list production:p
	{:
	  if (list == null) list = new ArrayList<>();
	  if (p != null) list.add(p);
	  RESULT = list;
	:}
	| production:p
	{:
	  var r = new ArrayList<ProductionNode>();
	  if (p != null) r.add(p);
	  RESULT = r;
	:};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

production ::=
	nt_id:lhs_id
	{: :}
	COLON_COLON_EQUALS
	rhs_list:alts
	SEMI
	{:
	  RESULT = new ProductionNode(lhs_id,
	      (ComplexLocation) lhs_idSym.getLocation(), alts, false);
	:}
	|
	error
	{: ErrorManager.getManager().emit_error("Syntax Error"); :}
	SEMI
	{: RESULT = new ProductionNode("ILLEGAL", null,
	      new ArrayList<RhsNode>(), true); :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

rhs_list ::= rhs_list:list BAR rhs:r
	{:
	  if (list == null) list = new ArrayList<>();
	  list.add(r);
	  RESULT = list;
	:}
	| rhs:r
	{:
	  var rr = new ArrayList<RhsNode>();
	  rr.add(r);
	  RESULT = rr;
	:};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

rhs ::=
	prod_part_list:parts PERCENT_PREC term_id:term_name PERCENT_NAMER ID:prod_name
	{: RESULT = new RhsNode(parts, term_name, prod_name); :}
	|
	prod_part_list:parts PERCENT_NAMER ID:prod_name
	{: RESULT = new RhsNode(parts, null, prod_name); :}
	|
	prod_part_list:parts PERCENT_PREC term_id:term_name
	{: RESULT = new RhsNode(parts, term_name, null); :}
	|
	prod_part_list:parts
	{: RESULT = new RhsNode(parts, null, null); :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

prod_part_list ::= prod_part_list:list prod_part:p
	{:
	  if (list == null) list = new ArrayList<>();
	  if (p != null) list.add(p);
	  RESULT = list;
	:}
	| empty
	{: RESULT = new ArrayList<>(); :};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

prod_part ::=
	opt_spread:spread symbol_id:symid opt_quantifier:quantifier opt_label:labid
	{:
	  /* the part's anchor: the label token when there is one, otherwise
	     the whole symbol reference (the ID or the parenthesized group) */
	  var loc = labid != null
	      ? (ComplexLocation) labidSym.getLocation()
	      : (ComplexLocation) symidSym.getLocation();
	  RESULT = new SymbolPartNode(spread, symid, quantifier, labid, loc);
	:}
	|
	CODE_STRING:code_str
	{:
	  RESULT = new ActionPartNode(code_str,
	      (ComplexLocation) code_strSym.getLocation());
	:}
	;

opt_spread ::= SPREAD {: RESULT = true; :} | empty {: RESULT = false; :};

opt_quantifier ::=
  QUESTION {: RESULT = QuantifierNode.opt(); :}
  | star_or_plus:sp {: RESULT = QuantifierNode.starPlus("*".equals(sp)); :}
  | LBRACK symbol_id_list:list question_or_exclamation:qe RBRACK star_or_plus:sp {:
    RESULT = QuantifierNode.bracket(list, "*".equals(sp), "?".equals(qe)); :}
  | empty {: RESULT = null; :};

star_or_plus ::=
  STAR {: RESULT = "*"; :}
  | PLUS {: RESULT = "+"; :};

question_or_exclamation ::=
  QUESTION {: RESULT = "?"; :}
  | EXCLAMATION {: RESULT = "!"; :};

opt_return_type ::=
    COLON_COLON ID:type {: RESULT = type; :}
    | empty {: RESULT = null; :};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

opt_label ::=
	COLON label_id:labid
	{: RESULT = labid; :}
	|
	empty
	{: RESULT = null; :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

multipart_id ::=
	multipart_id:base DOT robust_id:another_id
	{: RESULT = base + "." + another_id; :}
	|multipart_id:base
        {: :}
        LT typearglist:types GT
         {: RESULT = base + "<" + types + ">"; :}
        |
	robust_id:an_id
	{: RESULT = an_id; :}
	;
/*. . . . . . . . . . . . .TUM CHANGES. . . . . . . . . . . . . . . */


typearglist ::=
            typearguement:arg
            {: RESULT = arg; :}
            | typearglist:list COMMA typearguement:arg
            {: RESULT = list + "," + arg; :}
            ;

typearguement ::=
              type_id:t
              {: RESULT = t; :}
              | wildcard:w
              {: RESULT = w; :}
              ;

wildcard ::=
         QUESTION
         {: RESULT = " ? "; :}
         | QUESTION EXTENDS type_id:t
         {: RESULT = " ? extends " + t; :}
         | QUESTION SUPER type_id:t
         {: RESULT = " ? super " + t; :}
         ;

/*. . . . . . . . . . .END TUM CHANGES. . . . . . . . . . . . . . . */


/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

import_id ::=
	multipart_id:name DOT STAR
	{: RESULT = name + ".*"; :}
	|
	multipart_id:name
	{: RESULT = name; :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

type_id ::= multipart_id:m {: RESULT = m; :}
	| type_id:t LBRACK RBRACK
	{: RESULT = t + "[]"; :}
       	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

new_term_id ::=
	ID:term_id
	{: RESULT = term_id; :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

new_non_term_id ::=
	ID:non_term_id
	{: RESULT = non_term_id; :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

nt_id ::=
	ID:the_id
	{: RESULT = the_id; :}
	| error
	{:
		ErrorManager.getManager().emit_error("Illegal use of reserved word");
		RESULT="ILLEGAL";
	:}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

symbol_id ::=
	ID:the_id
	{: RESULT = new NamedRefNode(the_id); :}
	| LPAREN:lp {: :} opt_return_type:type rhs_list:branches RPAREN
	{:
	  /* the branches' hidden non terminals and productions are now
	     created by Lowering.lowerAnonExpr at the point of use */
	  RESULT = new AnonExprNode(type, branches,
	                            (ComplexLocation) lpSym.getLocation());
	:}
	| error
	{:
		ErrorManager.getManager().emit_error("Illegal use of reserved word");
		RESULT = new NamedRefNode("ILLEGAL");
	:}
	;

symbol_id_list ::= symbol_id:item {:
    var list = new ArrayList<SymRef>();
    list.add(item);
    RESULT = list;
  :}
  | symbol_id_list:list symbol_id:item {:
    if (list == null) list = new ArrayList<>();
    list.add(item);
    RESULT = list;
  :};

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

label_id ::=
	robust_id:the_id
	{: RESULT = the_id; :}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

robust_id ::= /* all ids that aren't reserved words in Java */
	ID:the_id	{: RESULT = the_id; :}
	/* package is reserved. */
	/* import is reserved. */
	| CODE		{: RESULT = "code"; :}
	| ACTION	{: RESULT = "action"; :}
	| PARSER	{: RESULT = "parser"; :}
	| TERMINAL	{: RESULT = "terminal"; :}
	| NON		{: RESULT = "non"; :}
	| NONTERMINAL   {: RESULT = "nonterminal"; :}
	| INIT		{: RESULT = "init"; :}
	| SCAN		{: RESULT = "scan"; :}
	| WITH		{: RESULT = "with"; :}
	| START		{: RESULT = "start"; :}
	| PRECEDENCE	{: RESULT = "precedence"; :}
	| LEFT		{: RESULT = "left"; :}
	| RIGHT		{: RESULT = "right"; :}
	| NONASSOC	{: RESULT = "nonassoc"; :}
	| error
	{:
		ErrorManager.getManager().emit_error("Illegal use of reserved word");
		RESULT="ILLEGAL";
	:}
	;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

non_terminal ::= NON TERMINAL | NONTERMINAL;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

opt_semi ::= /* nothing */
	| SEMI;

/*. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .*/

empty ::= /* nothing */;

/*----------------------------------------------------------------*/
